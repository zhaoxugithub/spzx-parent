{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "spzx-order 模块接口调用明细",
    "locale": "zh-CN",
    "output": "doc/archify/spzx-order-api-detail.html",
    "viewBox": [1080, 560],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      { "id": "trade",    "label": "① 结算",       "focus": ["h5", "order", "cart"], "note": "getOrderTrade: 读购物车选中项并生成金额/流水号." },
      { "id": "submit",   "label": "② 下单",       "focus": ["h5", "order", "product", "db", "mq"], "note": "submitOrder: 去重/价格校验/锁库存/落库/删车/延迟关单." },
      { "id": "mq",       "label": "③ MQ 驱动",    "focus": ["order", "mq", "db"], "note": "支付成功→置已支付→扣库存; 超时→置取消→解锁库存." }
    ]
  },
  "participants": [
    { "id": "h5",     "type": "frontend",  "label": "H5 前端",     "sublabel": "spzx-ui" },
    { "id": "order",  "type": "backend",   "label": "订单服务",   "sublabel": "spzx-order" },
    { "id": "cart",   "type": "backend",   "label": "购物车",     "sublabel": "spzx-cart" },
    { "id": "product","type": "backend",   "label": "商品服务",   "sublabel": "spzx-product" },
    { "id": "mq",     "type": "messagebus","label": "RabbitMQ",   "sublabel": "异步消息" },
    { "id": "db",     "type": "database",  "label": "订单库",     "sublabel": "order_info/item/log" }
  ],
  "segments": [
    { "from": 154, "to": 256, "label": "① 结算 getOrderTrade" },
    { "from": 264, "to": 396, "label": "② 下单 submitOrder" },
    { "from": 404, "to": 480, "label": "③ MQ 驱动(支付成功/超时)" }
  ],
  "messages": [
    { "id": "trade-req",    "from": "h5",     "to": "order",  "y": 160, "label": "GET /orderInfo/trade 去结算", "variant": "default" },
    { "id": "trade-cart",   "from": "order",  "to": "cart",   "y": 188, "label": "getCartCheckedList 读选中购物车", "variant": "emphasis", "note": "购物车基于 Redis; 空则提示" },
    { "id": "trade-cartret","from": "cart",   "to": "order",  "y": 216, "label": "List<CartInfo>", "variant": "return" },
    { "id": "trade-vo",     "from": "order",  "to": "h5",     "y": 244, "label": "TradeVo{totalAmount, tradeNo}", "variant": "return", "note": "生成流水号存 Redis user:tradeNo:{userId}(5min)" },

    { "id": "submit-req",   "from": "h5",     "to": "order",  "y": 272, "label": "POST /orderInfo/submitOrder", "variant": "emphasis", "note": "Lua 脚本去重(Redis user:tradeNo)" },
    { "id": "submit-price", "from": "order",  "to": "product","y": 300, "label": "getSkuPriceList 校验最新价格", "variant": "emphasis", "note": "价格变动→更新购物车价并拒绝" },
    { "id": "submit-lock",  "from": "order",  "to": "product","y": 328, "label": "checkAndLock 锁定库存", "variant": "emphasis", "note": "@InnerAuth; 库存不足→拒绝" },
    { "id": "submit-db",    "from": "order",  "to": "db",     "y": 356, "label": "落库 order_info / order_item / order_log", "variant": "emphasis", "note": "@Transactional; 失败→发解锁库存" },
    { "id": "submit-mq",    "from": "order",  "to": "mq",     "y": 384, "label": "发送延迟关单(15min)", "variant": "dashed", "note": "下单成功同时取消购物车选中项" },

    { "id": "mq-pay",       "from": "mq",     "to": "order",  "y": 412, "label": "支付成功→订单置已支付", "variant": "dashed" },
    { "id": "mq-minus",     "from": "order",  "to": "mq",     "y": 440, "label": "发扣库存消息 spzx.minus", "variant": "dashed", "note": "商品服务消费后扣减 sku_stock" },
    { "id": "mq-unlock",    "from": "order",  "to": "mq",     "y": 468, "label": "超时→置取消→发解锁库存", "variant": "dashed", "note": "商品服务消费后释放预占库存" }
  ],
  "activations": [
    { "participant": "h5",    "from": 162, "to": 278, "type": "frontend" },
    { "participant": "order", "from": 162, "to": 474, "type": "backend" },
    { "participant": "product","from": 304, "to": 332, "type": "backend" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "结算 / 下单主链路",
      "items": [
        "去结算: 读购物车选中项→算金额→生成交易流水号",
        "下单: Lua 去重 + 价格校验 + 锁定库存(Feign)",
        "落库 order_info/order_item/order_log 三表(事务)"
      ]
    },
    {
      "dot": "rose",
      "title": "MQ 编排放置",
      "items": [
        "下单成功发 15 分钟延迟关单消息",
        "支付成功(MQ)→置已支付→发扣库存消息",
        "超时(MQ)→置取消→发解锁库存消息"
      ]
    },
    {
      "dot": "orange",
      "title": "跨服务依赖",
      "items": [
        "订单控制购物车(Redis)与商品(价格/库存)",
        "收货地址经 spzx-user; 支付经 spzx-payment",
        "聚合 DTO 位于 spzx-api-order/domain"
      ]
    }
  ]
}

  "cards": [
    {
      "dot": "emerald",
      "title": "短信验证码链路",
      "items": [
        "H5 请求 GET /sms/sendCode/{phone}, member 服务生成 4 位验证码",
        "验证码存 Redis phone:code:{phone}, 有效期 5 分钟",
        "通过阿里云短信服务下发, 注册时一次性校验收取"
      ]
    },
    {
      "dot": "rose",
      "title": "H5 认证特点",
      "items": [
        "用户名即 11 位手机号, 无 RBAC 角色/菜单权限",
        "密码 BCrypt 存储, 登录失败同样做错误次数锁定",
        "注册/登录均走认证中心, 内部 Feign 调用 @InnerAuth 保护"
      ]
    },
    {
      "dot": "orange",
      "title": "双层会话",
      "items": [
        "JWT 仅存 user_key/user_id/username 轻量声明",
        "会话(LoginUser)存 Redis 12 小时, 支持注销/踢人/续期",
        "登录成功额外调用更新最近登录 IP 与时间"
      ]
    }
  ]

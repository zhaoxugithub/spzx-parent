# =============================================================================
# spzx 远程部署配置（可选文件）
#
# 用法：
#   cp docker/deploy.env.example docker/deploy.env     # 复制一份
#   vi docker/deploy.env                               # 按需取消注释/修改
#   ./docker/remote-deploy.sh config                   # 确认生效的配置
#   ./docker/remote-deploy.sh all ui                   # 之后直接跑，无需再带环境变量
#
# 规则：
#   * 优先级：命令行/环境变量  >  本文件  >  脚本内置默认值
#   * 语法 KEY=VALUE，一行一个；# 开头是注释；值可加引号也可不加
#   * 不需要的键就保持注释状态（下面每行都写了内置默认值，取消注释即覆盖）
#   * 文件位置（按顺序找第一个存在的）：
#       <仓库>/docker/deploy.env   ← 推荐
#       <仓库>/.deploy.env
#       ~/.spzx-deploy.env         ← 想全局复用可放这里
#     也可用 DEPLOY_ENV=/任意/路径.env 指定
#   * 这是可选的：不建这个文件也能跑，全部走默认值
# =============================================================================

# ---- 目标服务器 ----
SSH_HOST=root@192.168.5.3
SSH_PORT=22
REMOTE_DIR=/opt/spzx
HOST_IP=192.168.5.3      # 外网验证用；默认从 SSH_HOST 的 @ 后半段推导

# ---- Nacos / Sentinel（换服务器必改 NACOS_ADDR，且必须重新 build）----
# NACOS_ADDR=192.168.5.3:8848  # 打包时 -Dnacos.addr 写进 jar
# NACOS_API=http://127.0.0.1:8848    # 脚本查注册状态用
# SENTINEL_DASHBOARD=192.168.5.3:8858

# ---- 对外端口 ----
GATEWAY_PUBLISH="19080:8080"   # 网关（空格分隔可多个端口）
UI_PUBLISH="80:80"             # 前端
INTERNAL_BIND=127.0.0.1        # auth/system 只绑回环

# ---- 只处理部分服务（留空/注释=全部；命令行参数优先）----
# ONLY="gateway auth system ui"  # 可用：gateway auth system product ui

# ---- 常用开关 ----
# SKIP_MAVEN=1                   # 跳过后端 Maven 打包（用 target/ 已有 jar）
# SKIP_JARS=1                    # 跳过产物上传，只刷新 Dockerfile/compose
# SKIP_UI_BUILD=1                # 跳过前端构建
# TAG=latest                     # 镜像标签（版本化：TAG=v1.0.0）
# IMAGE_PREFIX=spzx
# XFER=auto                      # auto|scp|rsync

# ---- 内存（服务器内存紧张时重点调这里）----
GATEWAY_HEAP=192m
AUTH_HEAP=192m
SYSTEM_HEAP=320m
PRODUCT_HEAP=384m
UI_MEM=64m                     # 前端 nginx 硬上限
GATEWAY_MEM=                   # 可选 cgroup 硬上限，留空=不限制（其余服务同理：AUTH_MEM/SYSTEM_MEM/PRODUCT_MEM）
JVM_OPTS_EXTRA=                # 追加到 JAVA_OPTS 末尾
CDS=1                          # 类数据共享，降低启动时间与元数据内存
CDS_DIR=/opt/spzx/deploy/cds

# ---- verify 的"完整登录链路"（第⑦步）需要 Redis 口令；不填则自动跳过该步 ----
# REDIS_CONTAINER=1Panel-redis-xmqE
# REDIS_PASSWORD=
# LOGIN_USER=admin
# LOGIN_PASSWORD=admin123

    {
      "id": "config:spzx-modules/spzx-system/src/main/resources/mapper/system/SysMenuMapper.xml",
      "type": "config",
      "name": "SysMenuMapper.xml",
      "filePath": "spzx-modules/spzx-system/src/main/resources/mapper/system/SysMenuMapper.xml",
      "summary": "菜单权限(sys_menu)表的 MyBatis 映射文件,提供菜单树、按用户/角色查询菜单与权限标识、子菜单判断、名称唯一性校验以及新增、更新、删除等 SQL,绑定到 SysMenuMapper 接口,是 RBAC 权限核心映射。",
      "tags": ["mybatis", "mapper", "menu", "permission", "sql"],
      "complexity": "complex",
      "languageNotes": "通过多次 left join sys_role_menu/sys_user_role/sys_role 实现按用户的菜单与权限查询。"
    },

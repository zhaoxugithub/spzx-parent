      "type": "config",
      "name": "SysConfigMapper.xml",
      "filePath": "spzx-modules/spzx-system/src/main/resources/mapper/system/SysConfigMapper.xml",
      "summary": "spzx-system 模块中系统参数配置(sys_config)表的 MyBatis 映射文件,定义配置项的分页列表、按 key 查询、唯一性校验以及新增、更新、单删/批量删除等 SQL,绑定到 SysConfigMapper 接口。",
      "tags": ["mybatis", "mapper", "configuration", "sql", "crud"],
      "complexity": "moderate"
    },
    {
      "id": "config:spzx-modules/spzx-system/src/main/resources/mapper/system/SysDeptMapper.xml",
